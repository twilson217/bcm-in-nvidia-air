# switches.cmsh - Add switches to BCM and configure ZTP
# Uncomment and modify the examples below as needed.

cmsh -c "device;add switch mgmt-leaf-02;set mac 48:c2:b0:2d:00:0d;set vrf OOB;set defaultgateway 10.1.28.254;set hasclientdaemon yes;set nvconfigurationmode file;set nvconfigurationfile startup.yaml;interfaces;add physical vlan10;set network mgmtnet;set ip 10.1.28.14;set mac 48:c2:b0:2d:00:0d;set dhcp no;..;add physical swp40;set network mgmtnet;set ip 10.1.28.10;set mac 48:B0:2D:00:00:21;set dhcp yes;..;..;set managementnetwork mgmtnet;ztpsettings;set scripttemplate bootstrap-ztp.sh;set runztponeachboot no;set enableapi yes;set enableexternalaccessapi yes;keyvaluesettings;set CMD_INTERFACE vlan10;commit"
cmsh -c "device initialize mgmt-leaf-02"
