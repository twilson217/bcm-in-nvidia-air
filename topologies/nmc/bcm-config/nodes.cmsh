# nodes.cmsh - Add compute nodes to BCM inventory
# Uncomment and modify the examples below as needed.

cmsh -c "category use default; set disksetup /cm/local/apps/cmd/etc/htdocs/disk-setup/x86_64-slave-one-big-partition-xfs.xml; commit"
cmsh -c "device;add physicalnode cpu-01 10.1.37.11 bond0;set category default;interfaces;add physical ens8;set mac 48:B0:2D:45:D8:A9;add physical ens9;set mac 48:B0:2D:B6:18:31;use bond0;set network hpcnet;set interfaces ens8 ens9;set ip 10.1.37.11;..;..;set provisioninginterface bond0;set mac 48:B0:2D:45:D8:A9;commit"
cmsh -c "device;use cpu-01;interfaces;remove bootif;commit"
