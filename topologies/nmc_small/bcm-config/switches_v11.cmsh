# switches_v11.cmsh - Add switches to BCM 11.x and configure ZTP
# Small topology: leaf-01 only (in-band mgmt on vlan100 / internalnet)

cmsh -c "device;add switch leaf-01;set mac 48:b0:2d:00:00:16;set vrf INBAND;set defaultgateway 192.168.200.254;set hasclientdaemon yes;set nvconfigurationmode file;set nvconfigurationfile startup.yaml;interfaces;add physical swp31;set network internalnet;set ip 192.168.200.3;set mac 48:B0:2D:5F:EF:2E;set dhcp yes;..;add physical vlan100;set network internalnet;set ip 192.168.200.2;set mac 02:00:00:00:00:11;set dhcp no;..;..;set managementnetwork internalnet;ztpsettings;set runztponeachboot no;set enableapi yes;set enableexternalaccessapi yes;keyvaluesettings;set CMD_VRF INBAND;set CMD_INTERFACE vlan100;commit"
cmsh -c "device initialize leaf-01"