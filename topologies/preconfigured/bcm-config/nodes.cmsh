# nodes.cmsh - Add compute nodes to BCM inventory
# Uncomment and modify the examples below as needed.

cmsh -c "category use default; set disksetup /cm/local/apps/cmd/etc/htdocs/disk-setup/x86_64-slave-one-big-partition-xfs.xml; commit"
cmsh -c "device;add physicalnode cpu-01 10.1.37.11 bond0;set category default;interfaces;remove bootif;add physical ens8;set mac 48:B0:2D:45:D8:A9;set revision bootif;add physical ens9;set mac 48:B0:2D:B6:18:31;use bond0;set network hpcnet;set interfaces ens8 ens9;set ip 10.1.37.11;..;..;set provisioninginterface bond0;set mac 48:B0:2D:45:D8:A9;commit"
cmsh -c "device;add physicalnode cpu-02 10.1.37.12 bond0;set category default;interfaces;remove bootif;add physical ens8;set mac 48:B0:2D:5D:15:E8;set revision bootif;add physical ens9;set mac 48:B0:2D:1C:C9:74;use bond0;set network hpcnet;set interfaces ens8 ens9;set ip 10.1.37.12;..;..;set provisioninginterface bond0;set mac 48:B0:2D:5D:15:E8;commit"
cmsh -c "device;add physicalnode cpu-03 10.1.37.13 bond0;set category default;interfaces;remove bootif;add physical ens8;set mac 48:B0:2D:F4:5B:37;set revision bootif;add physical ens9;set mac 48:B0:2D:30:39:47;use bond0;set network hpcnet;set interfaces ens8 ens9;set ip 10.1.37.13;..;..;set provisioninginterface bond0;set mac 48:B0:2D:F4:5B:37;commit"
cmsh -c "device;add physicalnode cpu-04 10.1.37.14 bond0;set category default;interfaces;remove bootif;add physical ens8;set mac 48:B0:2D:E7:55:03;set revision bootif;add physical ens9;set mac 48:B0:2D:E4:61:61;use bond0;set network hpcnet;set interfaces ens8 ens9;set ip 10.1.37.14;..;..;set provisioninginterface bond0;set mac 48:B0:2D:E7:55:03;commit"
