# switches.cmsh - Add switches to BCM and configure ZTP
# Uncomment and modify the examples below as needed.

set cumulusmode file;set cumulusfile startup.yaml;ztpsettings;set scripttemplate bootstrap-ztp.sh;set enableapi yes;keyvaluesettings;set CMD_VRF mgmt;commit"

cmsh -c "device;add switch bootstrap;set mac 48:B0:2D:00:00:21;set vrf mgmt;set defaultgateway 10.1.28.254;set hasclientdaemon yes;set nvconfigurationmode file;interfaces;add physical eth0;set network mgmtnet;set ip 10.1.28.10;set mac 48:B0:2D:00:00:21;set dhcp yes;..;..;set managementnetwork mgmtnet;

cmsh -c "device initialize bootstrap"

cmsh -c "device;add switch mgmt-leaf-01;set mac 48:B0:2D:00:00:1E;set network mgmtnet;set ip 10.1.28.13;set hasclientdaemon yes;set cumulusmode file;set nvconfigurationfile startup.yaml;set cumulusfile startup.yaml;ztpsettings;set enableapi yes;keyvaluesettings;set CMD_VRF mgmt;commit"
cmsh -c "device initialize mgmt-leaf-01"
